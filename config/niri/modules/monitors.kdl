// Laptop
output "eDP-1" {
    off
    mode "1920x1200@60.003"
    scale 1.5
    backdrop-color "#000000"
    layout {
        background-color "#000000"
    }
}

// Laptop-external
output "HDMI-A-1" {
    // off
    mode "2560x1440@120"
    scale 1
    backdrop-color "transparent"
    layout {
        background-color "transparent"
    }
    hot-corners {
        off
    }
}

// PC
output "DP-1" {
    mode "2560x1440@119.999"
    scale 1

    backdrop-color "transparent"

    hot-corners {
        off
    }

    layout {
        background-color "transparent"
    }
}
