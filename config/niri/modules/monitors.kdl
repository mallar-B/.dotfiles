output "eDP-1" {
    off
    mode "1920x1200@60.003"
    scale 1.5
    backdrop-color "#000000"
    layout {
        background-color "#001100"
    }
}
output "HDMI-A-1" {
    mode "2560x1440@120"
    scale 1
    backdrop-color "transparent"
    layout {
        background-color "transparent"
    }
    hot-corners {
        off
    }
}
